# ============================================================
# BACKEND — Environment Variables
# ============================================================

# JWT Secret Key — generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-for-jwt

# Database — replace with your Supabase / Neon / production URL
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/notesexpress

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Allowed CORS origins (comma-separated, no spaces)
# For local dev: http://localhost:19006
# For production: https://yourdomain.com
ALLOWED_ORIGINS=*

# ============================================================
# FRONTEND — Expo Public Variables (prefix must be EXPO_PUBLIC_)
# ============================================================

# Your backend API URL
# Local dev (iOS Simulator):    http://127.0.0.1:8000
# Local dev (Android Emulator): http://10.0.2.2:8000
# Local dev (Physical Device):  http://<YOUR_WIFI_IP>:8000
# Production:                   https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# App branding (optional — overrides app.config.js defaults)
EXPO_PUBLIC_APP_NAME=Notes Express
EXPO_PUBLIC_APP_SLUG=notes-express
EXPO_PUBLIC_BUNDLE_ID=com.notesexpress.app

# EAS Project ID — get this by running: eas init
EXPO_PUBLIC_EAS_PROJECT_ID=
